# AGENTIS GENESIS - Environment Configuration
# Copy this file to .env.local for local development
# NEVER commit actual credentials to Git

# AWS Configuration
AWS_REGION=us-east-1
ENVIRONMENT=development

# Bedrock Configuration
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_API_KEY_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:genesis/bedrock/api-key-dev-abc123

# Database Configuration (RDS MariaDB via RDS Proxy)
DATABASE_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:genesis/database/mariadb-dev-abc123
DATABASE_NAME=genesis
DATABASE_PORT=3306
DATABASE_PROXY_ENDPOINT=genesis-db-proxy-dev.proxy-xyz.us-east-1.rds.amazonaws.com

# S3 Artifact Storage
ARTIFACT_BUCKET_NAME=agentis-genesis-artifacts-dev-123456789012-us-east-1

# API Configuration
API_BASE_URL=https://api.dev.agentis-genesis.example.com

# Mock AI for local development (set to "false" to use real Bedrock)
MOCK_AI=true

# Frontend (Next.js)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api