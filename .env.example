# AGENTIS GENESIS - Environment Configuration
# Copy this file to .env.local for local development
# NEVER commit actual credentials to Git

# AWS Configuration
AWS_REGION=us-east-1
ENVIRONMENT=development

# Bedrock Configuration
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_API_KEY_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:genesis/bedrock/api-key-dev-abc123

# Database Configuration (RDS MariaDB via RDS Proxy)
DATABASE_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:genesis/database/mariadb-dev-abc123
DATABASE_NAME=genesis
DATABASE_PORT=3306
DATABASE_PROXY_ENDPOINT=genesis-db-proxy-dev.proxy-xyz.us-east-1.rds.amazonaws.com

# S3 Artifact Storage
ARTIFACT_BUCKET_NAME=agentis-genesis-artifacts-dev-123456789012-us-east-1

# API Configuration
API_BASE_URL=https://api.dev.agentis-genesis.example.com

# Mock AI for local development (set to "false" to use real Bedrock)
MOCK_AI=true

# Frontend (Next.js)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# ---------------------------------------------------------------------------
# Deployed environment values
#
# These are NOT optional in a deployed environment. The /sdk console only
# targets the real backend when BOTH NEXT_PUBLIC_API_BASE_URL and
# NEXT_PUBLIC_COGNITO_DOMAIN are set correctly; otherwise it falls back to the
# clearly-labelled demonstration mode and never contacts the API.
#
# Populate these from the API stack outputs after deployment:
#   agentis-genesis-api-gateway-url-<env>
#   agentis-genesis-user-pool-client-id-<env>
#   agentis-genesis-user-pool-domain-<env>
# ---------------------------------------------------------------------------

# IMPORTANT: append /api to the exported gateway URL.
#
# The gateway route keys are "GET /api/health", "POST /api/work-trees", and so
# on, but the exported apiEndpoint is the bare host with no path. The client
# requests `${NEXT_PUBLIC_API_BASE_URL}/health`, so the base URL must carry the
# /api prefix. There is no Next.js rewrite and no local /api route, so a
# relative or suffix-less value is sent to the Next.js app itself and 404s.
NEXT_PUBLIC_API_BASE_URL=https://<api-id>.execute-api.<region>.amazonaws.com/api

# Cognito hosted UI. The domain output is a bare host with no scheme; the
# client prefixes "https://" itself, so do not include it here.
NEXT_PUBLIC_COGNITO_DOMAIN=<app>-<env>.auth.<region>.amazoncognito.com

NEXT_PUBLIC_COGNITO_CLIENT_ID=<user-pool-client-id>

# Optional. Defaults to "openid email profile" when unset. The user pool ID and
# a redirect URI are deliberately not read by the frontend: the redirect URI is
# derived from window.location.origin + /auth/callback, and the pool ID is
# carried inside the OIDC ID token.
NEXT_PUBLIC_COGNITO_SCOPE=openid email profile

# ---------------------------------------------------------------------------
# Deployment-time variable (read by the CDK app, not the runtime)
#
# ALLOWED_ORIGINS drives BOTH the API Gateway CORS origins and the Cognito
# callback URLs (<origin>/auth/callback). It must contain the exact origin the
# frontend is served from, or the browser is blocked and hosted-UI sign-in
# redirects are rejected. It is never a wildcard; an unset value allows no
# browser origin at all. It is read at synth time, so changing it requires
# re-deploying the API stack.
# ---------------------------------------------------------------------------
# ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com